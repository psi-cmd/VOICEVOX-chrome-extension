{
  "manifest_version": 3,
  "name": "VOICEVOX読み上げ",
  "description": "VOICEVOXを利用してテキストを読み上げる．予めVOICEVOXを起動する必要あり．",
  "version": "0.2",
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
